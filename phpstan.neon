parameters:
    level: 5
    paths:
        - web
        - dev
    excludePaths:
        # nur von der Analyse ausnehmen; Klassen (PHPMailer) bleiben bekannt
        analyse:
            # Fremdbibliothek
            - web/app/lib/*
            # Templates bekommen ihre Variablen per extract() aus render()
            - web/app/templates/*
