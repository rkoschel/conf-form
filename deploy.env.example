# FTP-Zugangsdaten für deploy.sh. Kopieren nach deploy.env (per .gitignore
# ausgeschlossen) und ausfüllen. Echte Zugangsdaten gehören NIE ins Repo.

FTP_HOST="ds12.serverdomain.org"
FTP_USER=""
FTP_PASSWORD=""

# FTP-Pfade (Login startet in /, entspricht den Server-Pfaden)
FTP_APP_DIR="/home/www/konferenz"
FTP_PRIVATE_DIR="/home/conf-form"

# Zertifikat prüfen. Schlägt die Prüfung fehl, weil das Zertifikat auf den
# Hostnamen des Hosters ausgestellt ist, besser FTP_HOST auf diesen Namen
# setzen statt die Prüfung abzuschalten.
FTP_VERIFY_CERT="true"
